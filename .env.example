## Copy this file to `.env.local` (do not commit `.env.local`)
## and set the values for your environment.

# Used by /api/sop/mark-obsolete and /api/sop/remove-obsolete
# to authorize marking/restoring SOPs as obsolete.
OBSOLETE_PASSWORD=

# Optional extra gate for admin security settings endpoints.
# If set, the admin UI will ask for it when updating sensitive settings.
ADMIN_SETTINGS_PASSWORD=

# Upstash Redis — shared cache across all Vercel serverless instances.
# Get from https://console.upstash.com → Create Database → REST API tab.
# When not set, the app falls back to per-instance in-memory caching (works locally).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

